# Copy this file to .env and fill in your own values.

# Port the API server listens on
PORT=4000

# Secret used to sign JWT auth tokens — change this to any long random string.
# Anyone with this secret can forge login tokens, so never commit the real value.
JWT_SECRET=change-this-to-a-long-random-string

# How long a login session (JWT) stays valid
JWT_EXPIRES_IN=7d

# The URL of your frontend (Vite dev server), used for CORS.
# Update this if you deploy the frontend somewhere else.
CLIENT_ORIGIN=http://localhost:5173
